# ==========================================
# StudyRot Environment Variables (.env.example)
# ==========================================

# 1. AI & LLM Inference (Groq Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. NCERT Grounding & Web Search (Tavily AI)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# 3. Optional Fallback Providers
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# 4. Supabase Database & Authentication
# Find these in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key

# 5. Application Secrets
MASTER_SECRET_KEY=your_master_aes_encryption_secret_minimum_32_chars
JWT_SECRET=your_jwt_signing_secret_here

# 6. Frontend Configuration (Optional)
# If hosting backend separately (e.g. Render/Railway), set your public backend URL here:
VITE_API_URL=
