      "verified": true,
      "supporting_sources": ["https://ncert.nic.in", "https://cbseacademic.nic.in"]
    },
    {
      "statement": "The standard equation of a parabola opening to the right along positive x-axis is $y^2 = 4ax$ with $a > 0$.",
      "latex": "y^2 = 4ax",
      "source": "NCERT Class 11/12 Maths Ch 11 Section 11.5",
      "source_url": "https://ncert.nic.in/textbook/pdf/kemh111.pdf",
