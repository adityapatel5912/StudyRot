  "definitions": [
    {
      "term": "Principal Focus",
      "definition": "The point on the principal axis where rays of light parallel to the axis converge or appear to diverge from after reflection or refraction.",
      "source": "NCERT Class 10 Science Ch 10 Section 10.2.2",
      "source_url": "https://ncert.nic.in/textbook/pdf/jesc110.pdf"
    },
    {
      "term": "Dioptre",
      "definition": "One dioptre is the power of a lens whose focal length is exactly one meter ($1\\ \\text{D} = 1\\ \\text{m}^{-1}$).",
      "source": "NCERT Class 10 Science Ch 10 Section 10.3.8",
      "source_url": "https://ncert.nic.in/textbook/pdf/jesc110.pdf"
    }
  ],
