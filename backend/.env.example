# StudyRot Backend Environment Variables
# Copy to backend/.env and provide your API keys

# Groq Cloud API Keys for LLaMA 3.3 70B generation
# Get your key at https://console.groq.com
GROQ_API_KEY=

# Tavily Search API Keys for web grounding
# Get your key at https://tavily.com
TAVILY_API_KEY=

# Supabase Auth & Database Credentials
# Get your project URL and keys from https://supabase.com dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (configured in Supabase Auth > Providers > Google)
# Credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Runtime Environment & Security
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
