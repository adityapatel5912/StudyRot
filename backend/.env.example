# StudyRot Backend Environment Variables
# Copy to backend/.env and provide your API keys

# Groq Cloud API Keys for LLaMA 3.3 70B generation
# Get your key at https://console.groq.com
GROQ_API_KEY=

# Tavily Search API Keys for web grounding
# Get your key at https://tavily.com
TAVILY_API_KEY=

# Supabase Auth & Database Credentials
# Get your project URL and keys from https://supabase.com dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (configured in Supabase Auth > Providers > Google)
# Credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice — Speech-to-Text (AssemblyAI Universal-3.5 Pro)
# Get your key at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Voice — Text-to-Speech (Fish Audio S2.1 Pro Free / OpenRouter)
# OpenRouter API Key for fish-audio/s2.1-pro-free:free (or native Fish Audio API)
OPENROUTER_API_KEY=
FISH_AUDIO_API_KEY=
FISH_VOICE_TEACHER=
FISH_VOICE_BUDDY=
FISH_VOICE_NARRATOR=

# NVIDIA NIM (Vision, OCR, Document Parsing, Deep Reasoning, 3D Assets)
# Get your key at https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_OCR_MODEL=nvidia/nemotron-ocr-v2
NVIDIA_PARSE_MODEL=nvidia/nemotron-parse-v1.2
NVIDIA_3D_MODEL=microsoft/trellis

# Runtime Environment & Security
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
